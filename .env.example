# =============================================================================
# Voice AI Patient Registration System — Environment Configuration
#
# Copy this file to .env and fill in your secrets before running.
# =============================================================================

# --- Application ---
APP_ENV=local
APP_NAME="Patient Registration Voice Agent"
APP_VERSION=1.0.0
DEBUG=true

# --- Database ---
# Docker Compose (default):
DATABASE_URL=postgresql+asyncpg://patient_reg:patient_reg_secret@localhost:5432/patient_registration
# Local SQLite fallback (uncomment to use without Docker):
# DATABASE_URL=sqlite+aiosqlite:///./data/patient_registration.db

# --- Vapi Voice AI ---
VAPI_API_KEY=your_vapi_api_key_here
VAPI_PHONE_NUMBER_ID=
VAPI_ASSISTANT_ID=

# --- Server ---
HOST=0.0.0.0
PORT=8000

# --- CORS ---
# Comma-separated origins for the dashboard frontend
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://127.0.0.1:3000

# --- ngrok (for Vapi webhook callbacks during development) ---
NGROK_AUTHTOKEN=
# The public base URL ngrok assigns (set after starting ngrok)
PUBLIC_BASE_URL=http://localhost:8000
